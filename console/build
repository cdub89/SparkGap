#!/usr/bin/env bash
# SparkGap Console builds, everything on Linux, with the dev-envt-guide build-release verbs:
#   ./build          dev install into .venv (the requirements, PyInstaller, pytest); no gates
#   ./build --check  every gate, then stop
#   ./build --all    gates, then the Linux app and the Windows app in dist/
# The apps are named after `git describe --always --dirty`, which Settings shows as the build.
# The script never commits, tags or pushes.
set -uo pipefail
cd "$(dirname "$(readlink -f "$0")")"
ALL=0 CHECK=0
for a in "$@"; do
  case $a in
    --all) ALL=1 ;;
    --check) CHECK=1 ;;
    *) echo "usage: ./build [--check | --all]" >&2; exit 2 ;;
  esac
done
PY=.venv/bin/python
die() { echo "build: $*" >&2; exit 1; }

[ -x $PY ] || python3 -m venv .venv || die "can't make .venv"
uv pip install -q --python $PY -r requirements.txt pyinstaller pytest || die "install failed"
if [ $ALL -eq 0 ] && [ $CHECK -eq 0 ]; then
  echo "dev install in .venv; run: .venv/bin/python sparkgap_console.py"; exit 0
fi

LOG=$(mktemp -d); trap 'rm -rf "$LOG" build.txt' EXIT
# the tools' full output goes to build.log; the screen gets one line a step
BLOG=build.log; : >"$BLOG"
NAME=$(git describe --always --dirty)
echo "BUILD $NAME"
FAILED=0
detail() { # the gate's own summary, from its output in $LOG/out
  case $1 in
    "py compile"|ruff) echo "${#PYFILES[@]} files" ;;
    pyright) grep -m1 -E '[0-9]+ errors?, [0-9]+ warnings?' "$LOG/out" ;;
    tests) grep -m1 -E '[0-9]+ passed' "$LOG/out" | sed -E 's/^=+ | =+$//g; s/ in [0-9.]+s//' ;;
    "no em dashes") echo "none in $(git ls-files --cached --others --exclude-standard ':!*.ttf' | wc -l) files" ;;
    "app starts") echo "QML loaded, no errors or warnings" ;;
  esac
}
gate() {
  local name=$1 t=$SECONDS; shift
  if "$@" >"$LOG/out" 2>&1; then echo "PASS $name ($(detail "$name"), $((SECONDS - t)) s)"
  else echo "FAIL $name"; tail -n 40 "$LOG/out"; FAILED=1; fi
  { echo "== gate: $name"; cat "$LOG/out"; } >>"$BLOG"
}
starts() { # the app runs 8 s with no errors or QML warnings, with its settings in a scratch folder
  local out rc
  out=$(QT_QPA_PLATFORM=offscreen XDG_CONFIG_HOME="$LOG/cfg" timeout 8 "$@" 2>&1); rc=$?
  echo "$out"
  [ $rc -eq 124 ] && ! grep -qiE "qml|error|traceback|warning" <<<"$out"
}
PYFILES=(sparkgap_console.py backend.py win_launcher.py tests/*.py)
gate "py compile" $PY -m py_compile "${PYFILES[@]}"
# from the repo root with the same settings as the repo's gates (.claude/bin/gates): the tests import
# feed_server from there, and ruff sorts imports as it does for the whole repo
REPO=("${PYFILES[@]/#/console/}")
gate "ruff" bash -c 'cd .. && uvx ruff check --quiet --isolated --target-version py310 --select E,W,F,I,UP,B \
  --line-length 100 "$@"' _ "${REPO[@]}"
gate "pyright" bash -c 'cd .. && uvx pyright --pythonversion 3.10 --pythonpath console/.venv/bin/python "$@"' _ "${REPO[@]}"
gate "tests" $PY -m pytest -q tests
gate "no em dashes" bash -c '! git grep --untracked -nIP "\x{2014}" -- . ":!*.ttf"'
gate "app starts" starts $PY sparkgap_console.py
[ $FAILED -eq 0 ] || die "gates failed"
[ $ALL -eq 1 ] || exit 0

rm -rf dist build-work; mkdir -p dist
echo "$NAME" > build.txt  # the spec and the Windows zip both pick it up
bad() { echo "FAIL $1"; tail -n 40 "$BLOG"; echo "LOG  $BLOG"; exit 1; }
size() { du -sh "$1" | cut -f1; }

T=$SECONDS
echo "== Linux app (PyInstaller)" >>"$BLOG"
.venv/bin/pyinstaller --noconfirm --distpath dist --workpath build-work SparkGapConsole.spec >>"$BLOG" 2>&1 ||
  bad "Linux app"
echo "DONE Linux app PyInstaller $(.venv/bin/pyinstaller --version): $(size dist/SparkGapConsole) folder ($((SECONDS - T)) s)"
echo "== Linux app starts" >>"$BLOG"
starts dist/SparkGapConsole/SparkGapConsole >>"$BLOG" 2>&1 || bad "Linux app starts"
echo "PASS Linux app starts (ran 8 s with no errors or QML warnings)"
TGZ="dist/SparkGapConsole-$NAME-linux-$(uname -m).tar.gz"
tar -C dist -czf "$TGZ" SparkGapConsole
rm -rf dist/SparkGapConsole build-work
echo "DONE Linux app $(basename "$TGZ") ($(size "$TGZ"))"

T=$SECONDS
echo "== Windows app zip" >>"$BLOG"
./windows_zip.sh dist "$NAME" 2>>"$BLOG" || bad "Windows app zip"
ZIP="dist/SparkGapConsole-$NAME-windows-x64.zip"
echo "DONE Windows   $(basename "$ZIP") ($(size "$ZIP"), $((SECONDS - T)) s)"
echo "LOG  $BLOG (full output of every step)"
